# Rust API (iso-api) — build บน Linux แล้วรันบน Debian slim (มี pg_dump สำหรับ backup รายวัน)
FROM rust:1-bookworm AS build
WORKDIR /src
COPY api/Cargo.toml api/Cargo.lock ./
COPY api/src ./src
RUN cargo build --release

FROM debian:bookworm-slim
# pg_dump ต้องเป็นเวอร์ชันเดียวกับ server (postgres:16) → ใช้ repo PGDG
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata curl gnupg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
 && apt-get purge -y curl gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Bangkok
WORKDIR /app
COPY --from=build /src/target/release/iso-api /app/iso-api
EXPOSE 8085
CMD ["/app/iso-api"]
