# Go converter (docx → html) — compile ข้ามสถาปัตยกรรมเป็น static binary
FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS build
ARG TARGETARCH
WORKDIR /src
COPY converter/ ./
RUN rm -f *.exe && CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -o /iso-converter .

FROM alpine:3.20
RUN apk add --no-cache tzdata ca-certificates
ENV TZ=Asia/Bangkok
COPY --from=build /iso-converter /usr/local/bin/iso-converter
CMD ["iso-converter"]
